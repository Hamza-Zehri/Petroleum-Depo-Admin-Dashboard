# Firebase web configuration for the Petroleum Depot admin dashboard.
#
# These are PUBLIC client values (not secrets) — the same values already ship
# inside the Android app. They are inlined by Vite (`VITE_*` prefix) at build
# time. Copy this file to `.env` and override only if you deploy against a
# different Firebase project.
VITE_FIREBASE_API_KEY=AIzaSyA2Xxz9r_wNfg9-zdncYHW5_iyNyqiXZvs
VITE_FIREBASE_AUTH_DOMAIN=petroleum-depot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petroleum-depot
VITE_FIREBASE_STORAGE_BUCKET=petroleum-depot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1075561100968
VITE_FIREBASE_APP_ID=1:1075561100968:web:29675039c19d776db9f49d
VITE_FIREBASE_MEASUREMENT_ID=G-VEJMJ7GWPB

# Firebase Auth UID that owns the depot. On this account's first sign-in the app
# auto-creates its owner profile + the one-time bootstrap lock.
VITE_OWNER_UID=MGtP71uoi6XWeOcSa4AwldhVo552
